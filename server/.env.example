# ==============================================================================
# KONFIGURASI SERVER / BACKEND
# ==============================================================================

# Port tempat server Fastify berjalan
PORT=4000

# URL Koneksi ke Database PostgreSQL
# Format: postgres://[user]:[password]@[host]:[port]/[nama_database]
DATABASE_URL=postgres://postgres:mypassword@localhost:5432/postgres

# ==============================================================================
# KONFIGURASI AUTENTIKASI & CORS
# ==============================================================================

# Kunci rahasia untuk mengamankan sesi otentikasi (cookie & token).
# Gunakan string acak yang panjang (bisa didapatkan dengan `openssl rand -base64 32`)
BETTER_AUTH_SECRET=<secret-key>

# Base URL dari server backend ini sendiri (URL tempat API berjalan)
BETTER_AUTH_URL=http://localhost:4000

# Base URL dari aplikasi Frontend (Next.js) yang diizinkan mengakses API (CORS)
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# KONFIGURASI KEAMANAN DATA SENSITIF
# ==============================================================================

# Kunci untuk Enkripsi AES-256 pada data kependudukan (WAJIB Minimal 32 Karakter)
# Digunakan agar data tetap aman saat tersimpan di dalam database.
ENCRYPTION_SECRET_KEY=<encryption-secret-key-minimal-32-karakter>

# Kunci Salt untuk Blind Indexing (Hashing) NIK dan KK
# Digunakan agar NIK dan KK tetap dapat dicari di sistem walaupun terenkripsi.
HASH_SALT=<masukkan-garam-hashing-unik-disini>

# ==============================================================================
# KONFIGURASI TESTING API (OPSIONAL)
# ==============================================================================
# Kredensial akun admin untuk menjalankan script pengujian (npm run test:api)
TEST_ADMIN_USERNAME=admin_desa
TEST_ADMIN_PASSWORD=sandi_rahasia_123

# ==============================================================================
# KONFIGURASI MINIO / S3 STORAGE
# ==============================================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=kependudukan
MINIO_PUBLIC_URL=http://localhost:9000/kependudukan