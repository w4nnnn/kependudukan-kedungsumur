# ==============================================================================
# KONFIGURASI FRONTEND (NEXT.JS)
# ==============================================================================

# Base URL untuk API Backend (Fastify Server)
# Default port server backend Fastify adalah 4000.
# Variabel yang diawali dengan NEXT_PUBLIC_ dapat diakses dari sisi klien (browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Allowed Dev Origins (Opsional untuk development di custom domain/tunnel, dipisahkan koma jika lebih dari satu)
# Contoh: kependudukan-kedungsumur.w4nn.my.id, *.w4nn.my.id
ALLOWED_DEV_ORIGINS=
